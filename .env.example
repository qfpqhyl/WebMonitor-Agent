# Copy to .env; replace the password before starting Compose.
COMPOSE_PROJECT_NAME=webmonitor-agent
POSTGRES_PORT=5433
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
WEBMONITOR_DEV_IMAGE=webmonitor-agent-dev:local

# Host-side connection settings (Docker overrides the host and port).
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=webmonitor
PGUSER=postgres

# Model settings for the host Conda environment. Put the real key in .env only.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:8317/v1
OPENAI_MODEL=gpt-6.1-sol
# Containers reaching this host service must use http://host.docker.internal:8317/v1.

# Mail: implicit TLS; set real app passwords in .env only.
# mail.stu.xidian.edu.cn has a certificate hostname mismatch; use its DNS alias.
SMTP_HOST=edu.icoremail.net
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_STARTTLS=false
MAIL_FROM=
# Explicit smoke-test recipient, not a default notification recipient.
MAIL_TEST_TO=
IMAP_HOST=edu.icoremail.net
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_USE_SSL=true

# Local development application (not a production deployment).
APP_ORIGIN=http://localhost:8080
DEVELOPMENT_MODE=true
SESSION_TTL_HOURS=168
REGISTRATION_ALLOWED_EMAILS=
OPENAI_CONTAINER_BASE_URL=
# Runtime signing/database/evidence credentials are generated by init-db into
# separate named volumes. Do not place runtime credentials in .env.
S3_BUCKET=webmonitor-evidence
# Optional local MinIO root identity. If omitted, password uses POSTGRES_PASSWORD.
S3_ROOT_USER=webmonitor-admin
S3_ROOT_PASSWORD=
WEBMONITOR_HTTP_PORT=8080
# Only export SMOKE_TOKEN (random, >=32 characters) when using compose.smoke.yaml.
# Do not configure a fixed smoke token or enable the fixture in normal Compose.
